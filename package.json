{
  "name": "vrtks-digital",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:all": "docker compose up -d --wait postgres && pnpm dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "publish:content": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/publish-content.ts",
    "publish:ai-search-post": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/publish-ai-search-post.ts",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "seed:projects": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-projects.ts",
    "update:imagery": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/update-johannesburg-imagery.ts",
    "update:content": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/update-site-content.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts",
    "test:integration": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int --config ./vitest.config.mts",
    "test:a11y": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test tests/e2e/accessibility.e2e.spec.ts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "pnpm run test:integration",
    "payload:generate-types": "pnpm generate:types",
    "payload:generate-importmap": "pnpm generate:importmap",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "payload:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "prebuild": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migrate-projects-production.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "audit:all": "pnpm audit --audit-level high",
    "verify": "pnpm payload:generate-types && pnpm payload:generate-importmap && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/auth": "0.6.0-beta",
    "@payloadcms/admin-bar": "3.91.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/plugin-nested-docs": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-search": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "gsap": "^3.15.0",
    "lucide-react": "0.563.0",
    "next": "16.4.2",
    "next-sitemap": "^4.2.3",
    "payload": "3.91.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.5",
    "swiper": "^14.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "sass": "1.77.4",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=5 <6": "5.0.12",
      "dompurify": "3.4.16",
      "esbuild@<0.25.0": "0.25.12",
      "fast-copy": "3.1.0",
      "fast-uri": "3.1.8",
      "js-yaml": "4.3.2",
      "postcss": "8.5.31",
      "postcss-selector-parser": "7.1.6",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici": "7.29.1",
      "vite@>=7.0.0 <7.3.7": "7.3.7"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
