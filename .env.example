# Neon pooled connection string used by the application
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vrtks_digital

# Neon direct connection string used for migrations
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/vrtks_digital

# Neon branch and managed authentication endpoints (`neon deploy` fills these)
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://example.neonauth.example/v1
NEON_AUTH_JWKS_URL=https://example.neonauth.example/.well-known/jwks.json

# Optional 32+ character Neon Auth cookie secret; a key is derived from PAYLOAD_SECRET when omitted
NEON_AUTH_COOKIE_SECRET=YOUR_SECRET_HERE

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Resend API credential and verified sender for password reset emails
RESEND_API_KEY=re_YOUR_API_KEY_HERE
RESEND_FROM_ADDRESS=no-reply@your-verified-domain.com
RESEND_FROM_NAME=VRTKS Digital
